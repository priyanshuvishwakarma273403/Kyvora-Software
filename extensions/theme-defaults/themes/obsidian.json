		"terminal.border": "#1e1e22",
		"terminalCursor.foreground": "#a98de8"
	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#7c758d"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "#c084fc"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"variable.function"
			],
			"settings": {
				"foreground": "#38bdf8"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source"
			],
			"settings": {
				"foreground": "#34d399"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"entity.name.scope-resolution",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#fb923c"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#fbbf24"
			}
		},
		{
			"scope": [
				"punctuation",
				"keyword.operator",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#a6a0b5"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other",
				"variable.language",
				"variable.parameter"
			],
			"settings": {
				"foreground": "#f3f4f6"
			}
		}
	],
	"semanticHighlighting": true
}
